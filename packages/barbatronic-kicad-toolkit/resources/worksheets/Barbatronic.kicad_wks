( page_layout
    ( setup (textsize 1.5 1.5) (linewidth 0.15) (textlinewidth 0.15)
      (left_margin 10) (right_margin 10) (top_margin 10) (bottom_margin 10) )

    ( rect (comment "cadre de page") (start 0 0 ltcorner) (end 0 0 rbcorner) (repeat 2) (incrx 0.8) (incry 0.8) )

    ( line (comment "graduations haut") (start 50 2 ltcorner) (end 50 0 ltcorner) (repeat 30) (incrx 50) )
    ( tbtext "1" (pos 25 1 ltcorner) (font (size 1.3 1.3)) (justify center) (repeat 100) (incrx 50) )
    ( line (comment "graduations bas") (start 50 2 lbcorner) (end 50 0 lbcorner) (repeat 30) (incrx 50) )
    ( tbtext "1" (pos 25 1 lbcorner) (font (size 1.3 1.3)) (justify center) (repeat 100) (incrx 50) )
    ( line (comment "graduations gauche") (start 0 50 ltcorner) (end 2 50 ltcorner) (repeat 30) (incry 50) )
    ( tbtext "A" (pos 1 25 ltcorner) (font (size 1.3 1.3)) (justify center) (repeat 100) (incry 50) )
    ( line (comment "graduations droite") (start 0 50 rtcorner) (end 2 50 rtcorner) (repeat 30) (incry 50) )
    ( tbtext "A" (pos 1 25 rtcorner) (font (size 1.3 1.3)) (justify center) (repeat 100) (incry 50) )

    ( rect (comment "contour du cartouche") (linewidth 0.3) (start 142 40) (end 2 2) )

    ( line (comment "bandeau de marque") (linewidth 0.3) (start 142 34) (end 2 34) )
    ( tbtext "BARBATRONIC" (pos 140 37) (font bold (size 3.2 3.2)) (justify left) )
    ( tbtext "%Y" (comment "organisation") (pos 4 36.4) (font (size 1.6 1.6)) (justify right) )

    ( line (start 142 26) (end 2 26) )
    ( tbtext "%T" (comment "titre") (pos 140 31) (font bold (size 2.6 2.6)) (justify left) )
    ( tbtext "%C0" (comment "sous-titre / sous-ensemble") (pos 140 27.8) (font italic (size 1.6 1.6)) (justify left) )

    ( line (start 142 20) (end 2 20) )
    ( tbtext "Fichier" (pos 140 24.6) (font (size 1.2 1.2)) (justify left) )
    ( tbtext "%F" (pos 140 21.8) (justify left) )
    ( tbtext "%K" (comment "version de KiCad") (pos 4 21.8) (font (size 1.2 1.2)) (justify right) )

    ( line (start 142 14) (end 2 14) )
    ( line (start 72 20) (end 72 14) )
    ( tbtext "Feuille" (pos 140 18.6) (font (size 1.2 1.2)) (justify left) )
    ( tbtext "%P" (pos 140 15.8) (justify left) )
    ( tbtext "Index" (pos 70 18.6) (font (size 1.2 1.2)) (justify left) )
    ( tbtext "%S / %N" (pos 70 15.8) (justify left) )

    ( line (start 142 8) (end 2 8) )
    ( line (start 72 14) (end 72 8) )
    ( tbtext "Date" (pos 140 12.6) (font (size 1.2 1.2)) (justify left) )
    ( tbtext "%D" (pos 140 9.8) (justify left) )
    ( tbtext "Révision" (pos 70 12.6) (font (size 1.2 1.2)) (justify left) )
    ( tbtext "%R" (pos 70 9.8) (font bold) (justify left) )

    ( line (start 72 8) (end 72 2) )
    ( tbtext "Licence" (pos 140 6.6) (font (size 1.2 1.2)) (justify left) )
    ( tbtext "%C3" (pos 140 3.8) (font (size 1.3 1.3)) (justify left) )
    ( tbtext "Format" (pos 70 6.6) (font (size 1.2 1.2)) (justify left) )
    ( tbtext "%Z" (pos 70 3.8) (justify left) )
)
