(version 1)

# Règles de conception pour JLCPCB, 1 à 2 couches, cuivre 1 oz, options standard.
# Valeurs volontairement plus prudentes que les minimums absolus annoncés par le
# fabricant, pour garder une marge de fabrication.
# Capacités relevées sur https://jlcpcb.com/capabilities/pcb-capabilities

(rule "Largeur de piste minimale"
	(constraint track_width (min 0.127mm))
	(layer outer))

(rule "Isolation cuivre minimale"
	(constraint clearance (min 0.127mm))
	(layer outer))

(rule "Diamètre de perçage des vias"
	(constraint hole_size (min 0.3mm))
	(condition "A.Type == 'Via'"))

(rule "Diamètre extérieur des vias"
	(constraint via_diameter (min 0.6mm))
	(condition "A.Type == 'Via'"))

(rule "Couronne de via minimale"
	(constraint annular_width (min 0.15mm))
	(condition "A.Type == 'Via'"))

(rule "Perçage des trous traversants"
	(constraint hole_size (min 0.3mm))
	(condition "A.Type == 'Pad' && A.isPlated()"))

(rule "Écart entre perçages"
	(constraint hole_to_hole (min 0.5mm)))

(rule "Cuivre au bord de carte"
	(constraint edge_clearance (min 0.3mm)))

(rule "Sérigraphie sur pastille"
	(constraint silk_clearance (min 0.15mm)))

(rule "Hauteur de texte de sérigraphie"
	(constraint text_height (min 1mm))
	(layer "?.Silkscreen"))

(rule "Épaisseur de texte de sérigraphie"
	(constraint text_thickness (min 0.15mm))
	(layer "?.Silkscreen"))
